<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EFO Névsor"
        Width="700"
        Height="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="{DynamicResource BackgroundBrush}">
    <DockPanel>
        <!-- HEADER -->
        <Border DockPanel.Dock="Top"
                Style="{DynamicResource CardBorder}"
                Margin="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="EFO Névsor"
                               FontSize="24"
                               FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Módosítások elvetése"
                            Width="180"
                            Margin="0,0,10,0"
                            Command="{Binding ReloadCommand}"/>
                    <Button Content="Mentés"
                            Width="120"
                            Style="{DynamicResource PrimaryButton}"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- FOOTER -->
<Border DockPanel.Dock="Bottom"
        Style="{DynamicResource CardBorder}"
        Margin="12">
    <Grid>
        <TextBlock Text="{Binding StatusText.Value}"
                   Foreground="{DynamicResource MutedBrush}"
                   VerticalAlignment="Center"/>
        <Button Content="Bezárás"
                Width="110"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"/>
    </Grid>
</Border>
        <!-- MAIN CONTENT -->
        <!-- Last child: DockPanel gives this the remaining space -->
        <Border Margin="12"
                Style="{DynamicResource CardBorder}">
            <ContentControl x:Name="NameEditorHost"/>
        </Border>
    </DockPanel>
</Window>