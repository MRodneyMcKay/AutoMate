<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jelenléti ív névsor"
        Width="1100"
        Height="650"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="{DynamicResource BackgroundBrush}">


    <Window.Resources>

        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">

                        <TabPanel IsItemsHost="True"
                                  Background="Transparent"/>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>



    <DockPanel>



        <!-- HEADER -->

        <Border DockPanel.Dock="Top"
                Style="{DynamicResource CardBorder}"
                Margin="12">


            <Grid>


                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>



                <TextBlock Text="Jelenléti ívek névsora"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>



                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">


                    <Button 
                            Content="Módosítások elvetése"
                            Width="180"
                            Margin="0,0,10,0"
                            Command="{Binding ReloadCommand}"/>



                    <Button 
                            Content="Mentés"
                            Width="120"
                            Style="{DynamicResource PrimaryButton}"
                            Command="{Binding SaveCommand}"/>


                </StackPanel>


            </Grid>


        </Border>






        <!-- FOOTER -->

        <Border DockPanel.Dock="Bottom"
                Style="{DynamicResource CardBorder}"
                Margin="12">


            <Grid>


                <TextBlock Text="{Binding StatusText.Value}"
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"/>



                <Button
                        Content="Bezárás"
                        Width="110"
                        HorizontalAlignment="Right"
                        Command="{Binding CloseCommand}"/>


            </Grid>


        </Border>








        <!-- MAIN -->

        <Border Margin="12"
                Style="{DynamicResource CardBorder}">


            <Grid>


                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>








                <!-- DEPARTMENT TABS -->

                <Grid Grid.Row="0"
                      Margin="10,5,10,0">


                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>





                    <TabControl Grid.Column="0"
                                ItemsSource="{Binding Departments}"
                                SelectedItem="{Binding SelectedDepartment.Value, Mode=TwoWay}">


                        <TabControl.ItemTemplate>

                            <DataTemplate>


                                <TextBlock Text="{Binding DisplayName.Value}"
                                           FontWeight="SemiBold"
                                           Margin="5,2"/>


                            </DataTemplate>


                        </TabControl.ItemTemplate>


                    </TabControl>







                    <Button Grid.Column="1"
                            Content="+ Új"
                            Width="80"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding AddDepartmentCommand}"
                            CommandParameter="{Binding}"/>


                </Grid>









                <!-- DEPARTMENT CONTENT -->

                <Grid Grid.Row="1"
                      Margin="10">


                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>








                    <!-- POSITION TABS -->

                    <Grid Grid.Row="0"
                          DataContext="{Binding SelectedDepartment.Value}">


                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>





                        <TabControl Grid.Column="0"
                                    ItemsSource="{Binding Positions}"
                                    SelectedItem="{Binding SelectedPosition.Value, Mode=TwoWay}">


                            <TabControl.ItemTemplate>

                                <DataTemplate>


                                    <TextBlock Text="{Binding DisplayName.Value}"
                                               FontWeight="SemiBold"
                                               Margin="5,2"/>


                                </DataTemplate>


                            </TabControl.ItemTemplate>


                        </TabControl>







                        <Button Grid.Column="1"
                                Content="+ Munkakör"
                                Width="110"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding DataContext.AddPositionCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                />


                    </Grid>









                    <!-- NAME EDITOR HOST -->

                    <ContentControl x:Name="NameEditorContent"
                                    Grid.Row="1"
                                    Margin="0,10,0,0"/>





                </Grid>





            </Grid>


        </Border>


    </DockPanel>


</Window>