<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Manager"
        Height="760"
        Width="1120"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- HEADER -->
        <Border Grid.Row="0"
                Style="{DynamicResource CardBorder}"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Nyomtatási kezelő"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Válasszon egy jelenléti ív XLS/XLSX fájlt, majd jelölje ki a nyomtatandó feladatokat."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
        </Border>
        <!-- FILE PICKER -->
        <Border Grid.Row="1"
                Style="{DynamicResource CardBorder}"
                Margin="0,0,0,12"
                x:Name="SheetDropArea"
                AllowDrop="True">
            <StackPanel>
                <TextBlock Text="Jelenléti ív fájl"
                           Style="{DynamicResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Margin="0,0,10,0"
                             IsReadOnly="True"
                             IsHitTestVisible="False"
                             Text="{Binding SelectedSheetPath.Value}"/>
                    <Button Grid.Column="1"
                            Content="Tallózás"
                            Style="{DynamicResource PrimaryButton}"
                            Width="110"
                            Command="{Binding BrowseSheetCommand}"
                            CommandParameter="{Binding}"/>
                </Grid>
                <TextBlock Text="A kiválasztott fájl minden nyomtatási feladathoz használatos."
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <!-- TASK GROUP CARDS -->
        <Border Grid.Row="2"
                Style="{DynamicResource CardBorder}"
                Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Feladatok"
                               Style="{DynamicResource SectionHeader}"/>
                    <CheckBox Content="Összes kijelölése"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              IsThreeState="True"
                              IsChecked="{Binding SelectAll.Value, Mode=TwoWay}"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              MaxHeight="360">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="260"
                                           ItemHeight="Auto"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource CardBorder}"
                                        Margin="8"
                                        Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}"
                                                   Style="{DynamicResource SectionHeader}"
                                                   Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Tasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox
                                                        Content="{Binding Name}"
                                                        IsChecked="{Binding IsSelected.Value,
                                                                        Mode=TwoWay}"
                                                        ToolTip="{Binding ToolTip}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <!-- FOOTER BUTTONS -->
        <Grid Grid.Row="3"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Névsor kezelése"
                    Width="160"
                    Margin="0,0,10,0"
                    Command="{Binding ShowNamesCommand}"
                    CommandParameter="{Binding}"/>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Nyomtatás"
                        Style="{DynamicResource PrimaryButton}"
                        Width="140"
                        Margin="0,0,10,0"
                        Command="{Binding InvokeSelectedPrintTasksCommand}"
                        CommandParameter="{Binding}"/>
                <Button Content="Bezárás"
                        Width="110"
                        Command="{Binding CloseCommand}"
                        CommandParameter="{Binding}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
